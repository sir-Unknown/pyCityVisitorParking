{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name", "capabilities"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object",
      "required": ["favorite_update_fields", "reservation_update_fields"],
      "properties": {
        "favorite_update_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["license_plate", "name"]
          },
          "uniqueItems": true
        },
        "reservation_update_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["start_time", "end_time", "name"]
          },
          "uniqueItems": true
        },
        "balance_units": {
          "type": "array",
          "description": "Units in which remaining_balance is expressed. A single entry means the provider always uses that unit; multiple entries mean the unit is account-specific and returned per Permit at runtime. EURO balances may be stored in cents depending on the provider.",
          "items": {
            "type": "string",
            "enum": ["TIMES", "MINUTE", "EURO"]
          },
          "uniqueItems": true
        },
        "zone_selection": {
          "type": "boolean",
          "description": "Whether start_reservation accepts a zone_id from Permit.zones. When false or omitted, the provider rejects a zone_id and Permit.zones stays empty."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
